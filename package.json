{
  "name": "@cb3/eventlog",
  "version": "0.1.0",
  "description": "Errors, warnings and info events grouped and stored in MongoDB — shared by cbp3 and media-worker.",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./sveltekit": { "types": "./dist/sveltekit.d.ts", "default": "./dist/sveltekit.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "mongodb": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": { "optional": true }
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "@types/node": "^22.0.0",
    "mongodb": "^6.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
